# ---------------------------------------------------------------
# Data and models are NOT committed. Everything here is either a
# public download or is rebuilt by the scripts in replication/.
#   review-Hawaii.json.gz    290 MB  (Google Local Reviews release)
#   amazon_train.csv        1.28 GB  (rebuilt by external_data.py)
#   dynasent-v1.1.zip         17 MB  (public DynaSent release)
# GitHub rejects any single file over 100 MB.
# ---------------------------------------------------------------

data/
dynasent-v1.1/
models/
logs/
__MACOSX/
*.bin
*.zip
*.gz
*.json.gz
*.jsonl.gz

