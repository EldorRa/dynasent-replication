# ---------------------------------------------------------------
# LaTeX build artefacts (keep main.tex, references.bib, the PDF)
# ---------------------------------------------------------------
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# ---------------------------------------------------------------
# KEEP, explicitly — these are the evidence behind the paper and
# the negation rules must come after the patterns above.
# ---------------------------------------------------------------
!results/
!results/*.csv
!results/*.jsonl
!results/*.txt
!replication/results/*.csv
!replication/results/*.tex
!.gitignore
